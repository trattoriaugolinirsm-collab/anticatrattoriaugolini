{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/prenota", "destination": "/prenota.html", "permanent": false },
    { "source": "/menu-digitale", "destination": "/menu-digitale.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
